# Backend Environment Variables
PROJECT_NAME="StockFlow Minimal SaaS"
API_V1_STR="/api/v1"

# Database Configuration (PostgreSQL)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DB_NAME
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/stockflow_db

# Security & JWT Token
# Generate a secret key via: openssl rand -hex 32
SECRET_KEY=supersecretjwtkey_stockflow_minimum_change_me_in_prod
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS settings (frontend origin)
BACKEND_CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:3000"]
